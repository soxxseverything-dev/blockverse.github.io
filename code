<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Blockverse</title>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@700;900&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<style>
:root{--bg:#f1f3fb;--panel:#fff;--text:#1c2038;--mute:#667;--acc:#4f5dff;--coin:#f5b700;--line:#d5d9ee;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#15172a;--panel:#20233c;--text:#eef0ff;--mute:#9aa0c8;--acc:#7683ff;--line:#33385c}}
:root[data-theme="dark"]{--bg:#15172a;--panel:#20233c;--text:#eef0ff;--mute:#9aa0c8;--acc:#7683ff;--line:#33385c}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font-family:Nunito,system-ui,-apple-system,"Segoe UI",sans-serif;font-weight:700}
button{font:inherit;color:inherit;cursor:pointer;border:0}
button:focus-visible{outline:3px solid var(--acc);outline-offset:2px}
.hidden{display:none!important}
.top{display:flex;align-items:center;gap:10px;padding:12px 18px;background:var(--panel);border-bottom:2px solid var(--line);font-weight:900;font-size:22px}
.top i{width:26px;height:26px;background:var(--acc);border-radius:6px;transform:rotate(-12deg);box-shadow:inset -5px -5px 0 rgba(0,0,0,.2)}
main{max-width:1000px;margin:0 auto;padding:20px 16px}
h2{margin:0 0 12px;font-size:22px;font-weight:900}
.cont{display:flex;align-items:center;gap:14px;padding:14px;margin-bottom:24px;background:var(--panel);border:2px solid var(--line);border-radius:14px}
.cont .t{flex:1}.cont small{color:var(--mute)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:14px}
.card{background:var(--panel);border:2px solid var(--line);border-radius:14px;overflow:hidden;text-align:left;padding:0}
.card .art{height:120px;display:grid;place-items:center;font-size:54px}
.card .b{padding:10px 12px 12px}.card b{display:block;font-weight:900}.card small{color:var(--mute)}
.card:not(:disabled):hover{border-color:var(--acc)}.card:disabled{opacity:.6;cursor:not-allowed}
.btn{background:var(--acc);color:#fff;padding:10px 18px;border-radius:10px;font-weight:900}
.btn.alt{background:var(--panel);color:var(--text);border:2px solid var(--line)}
#game{position:fixed;inset:0;z-index:10;background:#8fd3ff;touch-action:none;user-select:none;-webkit-user-select:none}
#cv{display:block;width:100%;height:100%;touch-action:none}
.hud{position:absolute;left:0;right:0;top:env(safe-area-inset-top,0px);display:flex;gap:8px;align-items:center;padding:10px 12px;flex-wrap:wrap;pointer-events:none}
.hud>*{pointer-events:auto}
.pill{background:var(--panel);color:var(--text);border:2px solid var(--line);border-radius:999px;padding:6px 14px;font-weight:900}
#hint{position:absolute;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--panel);color:var(--text);border:2px solid var(--line);border-radius:12px;padding:8px 16px;font-weight:900;text-align:center;max-width:90vw;pointer-events:none}
#stick,#jb{position:absolute;bottom:calc(24px + env(safe-area-inset-bottom,0px));display:none;touch-action:none}
#stick{left:24px;width:120px;height:120px;border-radius:50%;background:rgba(255,255,255,.3);border:3px solid rgba(255,255,255,.6)}
#knob{position:absolute;left:35px;top:35px;width:50px;height:50px;border-radius:50%;background:rgba(255,255,255,.85)}
#jb{right:24px;width:84px;height:84px;border-radius:50%;background:rgba(255,255,255,.4);border:3px solid rgba(255,255,255,.7);font-weight:900}
@media (pointer:coarse){#stick,#jb{display:block}#hint{bottom:calc(160px + env(safe-area-inset-bottom,0px))}}
#auth{position:fixed;inset:0;z-index:30;display:grid;place-items:center;background:var(--bg);padding:20px}
.acard{width:min(420px,100%);background:var(--panel);border:2px solid var(--line);border-radius:18px;padding:28px;display:flex;flex-direction:column;gap:12px}
.acard h1{margin:0;font-size:32px;font-weight:900}
.acard input{padding:12px 14px;border-radius:10px;border:2px solid var(--line);background:var(--bg);color:var(--text);font:inherit;font-size:17px}
.acard small{color:var(--mute)}#aerr{color:#e5484d;min-height:1.2em}
main{max-width:1300px}.grid{grid-template-columns:repeat(auto-fill,minmax(270px,1fr))}.card .art{height:170px;font-size:76px}.top{font-size:26px}.cont{font-size:18px}.pill{font-size:18px}
</style>
</head>
<body>
<div id="auth"><div class="acard"><h1>🧱 Blockverse</h1><small>Crea una cuenta o inicia sesión para jugar</small>
<input id="au" placeholder="Usuario" maxlength="16" autocomplete="username"><input id="ap" type="password" placeholder="Contraseña" autocomplete="current-password">
<div id="aerr"></div><button class="btn" id="ali">Iniciar sesión</button><button class="btn alt" id="acr">Crear cuenta</button><small>Las cuentas se guardan solo en este dispositivo.</small></div></div>
<div id="hub" class="hidden">
  <div class="top"><i></i>Blockverse<span style="margin-left:auto;display:flex;gap:10px;align-items:center;font-size:17px">👤 <span id="who"></span><button class="btn alt" id="logout">Cerrar sesión</button></span></div>
  <main>
    <div class="cont"><div class="t"><b>Continuar jugando</b><br><small id="info"></small></div><button class="btn" data-play="tycoon" id="cbtn">Jugar</button></div>
    <h2>Juegos populares</h2>
    <div class="grid" id="grid"></div>
  </main>
</div>
<div id="game" class="hidden">
  <canvas id="cv"></canvas>
  <div class="hud">
    <button class="btn alt" id="exit">Salir (Esc)</button><button class="btn alt" id="fs" aria-label="Pantalla completa">⛶ Pantalla completa</button>
    <span class="pill" id="w"></span><span class="pill" id="b"></span><span class="pill" id="r"></span>
  </div>
  <div id="hint" class="hidden"></div>
  <div id="stick"><div id="knob"></div></div>
  <button id="jb">Saltar</button>
</div>

<script>
const $=id=>document.getElementById(id);
const GAMES=[
 {id:'tycoon',n:'Fábrica Tycoon 3D',d:'Explora y construye',e:'🏭',bg:'#ffb703',ok:1},
 {id:'lobby',n:'Torre Obby 3D',d:'Fácil · Medio · Difícil',e:'🧗',bg:'#4f5dff',ok:1},
 {n:'Isla Supervivencia',d:'Próximamente',e:'🏝️',bg:'#12b886'},
 {n:'Carreras Bloque',d:'Próximamente',e:'🏎️',bg:'#ff5d73'}];
const ITEMS=[
 {id:'belt',n:'Cinta',e:'➡️',c:15,p:1,x:24,z:-4},
 {id:'press',n:'Prensa',e:'🔨',c:100,p:5,x:28,z:-4},
 {id:'oven',n:'Horno',e:'🔥',c:600,p:25,x:32,z:-4},
 {id:'fact',n:'Fábrica',e:'🏭',c:3500,p:120,x:36,z:-4},
 {id:'reac',n:'Reactor',e:'⚛️',c:20000,p:600,x:24,z:4}];
const BANK={x:36,z:4};
let KEY='',USER='',S={coins:15,bank:0,own:{},pb:{}};
const ls=(k,v)=>{try{if(v===undefined)return JSON.parse(localStorage.getItem(k));localStorage.setItem(k,JSON.stringify(v))}catch(e){return null}};
const save=()=>{if(KEY)ls(KEY,S)};
async function sha(s){try{const b=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(s));return[...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,'0')).join('')}catch(e){return btoa(unescape(encodeURIComponent(s)))}}
async function auth(create){const u=$('au').value.trim(),p=$('ap').value,er=$('aerr'),acc=ls('bv-acc')||{};
 if(!/^\w{3,16}$/.test(u))return er.textContent='Usuario: 3-16 letras, números o _';
 if(p.length<4)return er.textContent='La contraseña necesita al menos 4 caracteres';
 const k=u.toLowerCase(),h=await sha(k+':'+p);
 if(create){if(acc[k])return er.textContent='Ese usuario ya existe';acc[k]={h,n:u};ls('bv-acc',acc)}
 else if(!acc[k]||acc[k].h!==h)return er.textContent='Usuario o contraseña incorrectos';
 ls('bv-session',{k,exp:Date.now()+14*864e5});enter(acc[k].n,k)}
function enter(n,k){USER=n;KEY='bv-save-'+k;S=Object.assign({coins:15,bank:0,own:{},pb:{}},ls(KEY)||ls('blockverse-mundo-v1')||{});
 $('auth').classList.add('hidden');$('hub').classList.remove('hidden');$('ap').value='';$('aerr').textContent='';$('who').textContent=USER;hub();initDB();initRoom()}
$('ali').onclick=()=>auth(false);$('acr').onclick=()=>auth(true);
$('ap').addEventListener('keydown',e=>{if(e.key==='Enter')auth(false)});
$('logout').onclick=()=>{save();ls('bv-session',null);KEY='';USER='';$('hub').classList.add('hidden');$('auth').classList.remove('hidden')};
/* clasificaciones: globales si hay db, si no locales */
let DB=null,UID=null,LBSRC='Local';
async function initDB(){if(DB||!window.claude||!claude.use)return;try{DB=await claude.use('db');const u=await claude.use('user');if(DB&&u){UID=await u.id();LBSRC='Global'}else DB=null}catch(e){DB=null}}
async function submit(d,t){const L=ls('bv-lb')||{},k=USER.toLowerCase(),r=L[k]||{n:USER};if(!r[d]||t<r[d])r[d]=t;L[k]=r;ls('bv-lb',L);
 if(DB&&UID)try{const ref=DB.collection('lb').doc(UID),sn=await ref.get(),o=(sn.exists&&sn.data())||{};if(!o[d]||t<o[d])await ref.set({...o,name:USER,[d]:t})}catch(e){}}
async function getLB(){let rows=Object.values(ls('bv-lb')||{});
 if(DB)try{const q=await DB.collection('lb').get();rows=q.docs.map(x=>x.data())}catch(e){}
 const o={};['easy','medium','hard'].forEach(d=>o[d]=rows.filter(r=>r[d]).sort((a,b)=>a[d]-b[d]).slice(0,5).map(r=>[r.n||r.name||'?',r[d]]));return o}
const fmt=n=>n>=1e6?(n/1e6).toFixed(2)+'M':n>=1e4?(n/1e3).toFixed(1)+'k':Math.floor(n).toLocaleString('es');
const cost=i=>Math.ceil(i.c*Math.pow(1.15,S.own[i.id]||0));
const cps=()=>ITEMS.reduce((a,i)=>a+i.p*(S.own[i.id]||0),0);

/* menú */
GAMES.forEach(g=>{const b=document.createElement('button');b.className='card';b.disabled=!g.ok;if(g.ok)b.dataset.play=g.id;
 b.innerHTML=`<div class="art" style="background:${g.bg}">${g.e}</div><div class="b"><b>${g.n}</b><small>${g.d}</small></div>`;$('grid').appendChild(b)});
function hub(){const n=Object.values(S.own).reduce((a,b)=>a+b,0);
 $('info').textContent=n?`Fábrica Tycoon 3D · ${fmt(S.coins)} monedas · ${n} máquinas`:'Fábrica Tycoon 3D · Partida nueva';
 $('cbtn').textContent=n?'Continuar':'Jugar'}
document.addEventListener('click',e=>{const p=e.target.closest('[data-play]');if(p)play(p.dataset.play)});

/* motor 3D */
let scene,cam,ren,sun,G,legL,legR,armL,armR,W=null,cur=null,inited=false,bd,cmin;
const P={x:0,y:0,z:0,vy:0,rot:0,mv:false,on:null,gr:true};
const circ=[],boxes=[],plats=[],coins=[],cvs=$('cv'),cam3={yaw:0,pitch:.45,dist:11};
const keys={};let jv={x:0,y:0},jump=false,playing=false,last=0,cd=0,hudT=0,helpT=0,hintOn='';
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const rnd=(()=>{let s=11;return()=>(s=(s*16807)%2147483647)/2147483647})();
function mesh(geo,col,x,y,z,parent,shadow){const m=new THREE.Mesh(geo,new THREE.MeshLambertMaterial({color:col}));m.position.set(x,y,z);if(shadow!==false){m.castShadow=true;m.receiveShadow=true}(parent||W).add(m);return m}
const B=(w,h,d,c,x,y,z,p)=>mesh(new THREE.BoxGeometry(w,h,d),c,x,y,z,p);
const Cy=(r1,r2,h,c,x,y,z,p,rx)=>{const m=mesh(new THREE.CylinderGeometry(r1,r2,h,14),c,x,y,z,p);if(rx)m.rotation.x=Math.PI/2;return m};
const glow=(m,c)=>{m.material.emissive.set(c);return m};
function label(){const c=document.createElement('canvas');c.width=256;c.height=128;const t=new THREE.CanvasTexture(c);
 const s=new THREE.Sprite(new THREE.SpriteMaterial({map:t,depthTest:false}));s.scale.set(4,2,1);s.renderOrder=5;
 let l='';s.set=(a,b)=>{if(a+b===l)return;l=a+b;const g=c.getContext('2d');g.clearRect(0,0,256,128);
  g.fillStyle='rgba(20,22,40,.75)';g.fillRect(8,24,240,80);g.textAlign='center';g.fillStyle='#fff';g.font='900 34px Nunito,sans-serif';g.fillText(a,128,62);
  g.fillStyle='#ffd23f';g.fillText(b,128,96);t.needsUpdate=true};W.add(s);return s}
function tree(x,z){const h=1.5+rnd()*1.5;mesh(new THREE.CylinderGeometry(.35,.45,2.4,6),0x6b4423,x,1.2,z);
 if(rnd()>.5)mesh(new THREE.ConeGeometry(1.9,h*2.2,7),0x2f8f46,x,2.4+h*1.1,z);else mesh(new THREE.SphereGeometry(1.8+h*.3,8,6),0x3aa356,x,3.6+h*.4,z);
 circ.push({x,z,r:.6})}

/* modelos de máquinas (cada uno devuelve su animación) */
function smoke(g,x,z,y0){const s=[0,1,2].map(()=>{const m=mesh(new THREE.SphereGeometry(.35,8,6),0xd1d5db,x,y0,z,g,false);m.material.transparent=true;return m});
 return t=>s.forEach((m,i)=>{const k=(t*.5+i/3)%1;m.position.y=y0+k*2.2;m.scale.setScalar(.6+k*1.2);m.material.opacity=.7*(1-k)})}
const MODELS={
 belt(g){B(3.6,.5,1.5,0x2f3645,0,.55,0,g);B(3.6,.12,1.3,0x151a24,0,.85,0,g);
  [-.78,.78].forEach(z=>B(3.6,.28,.14,0xf5b700,0,1,z,g));[-1.5,1.5].forEach(x=>B(.25,.4,1.3,0x475569,x,.2,0,g));
  [-1.8,1.8].forEach(x=>Cy(.42,.42,1.5,0x64748b,x,.85,0,g,1));
  const cr=[0,1,2].map(()=>B(.7,.6,.7,0xc08a4a,0,1.2,0,g));return t=>cr.forEach((c,i)=>c.position.x=((t*1.2+i*1.2)%3.6)-1.8)},
 press(g){B(2.6,.4,2.4,0x475569,0,.2,0,g);B(1.8,.25,1.4,0x94a3b8,0,.5,0,g);[-1.1,1.1].forEach(x=>B(.35,3,.35,0x64748b,x,1.9,0,g));B(2.8,.5,1,0x64748b,0,3.2,0,g);
  const h=new THREE.Group();g.add(h);Cy(.15,.15,1.2,0xcbd5e1,0,.8,0,h);B(1.5,.5,1.1,0xc2410c,0,0,0,h);return t=>h.position.y=1.15+Math.abs(Math.sin(t*2.2))*1.5},
 oven(g){B(2.6,2.2,2.2,0x9a3412,0,1.1,0,g);[.5,1,1.5,2].forEach(y=>B(2.64,.07,2.24,0x7c2d12,0,y,0,g));B(2.9,.25,2.5,0x44403c,0,2.3,0,g);
  B(1.3,1,.1,0x111111,0,1,1.1,g);const f=glow(B(1,.7,.06,0xff6a00,0,.95,1.14,g),0xff6a00);Cy(.35,.45,1.4,0x57534e,.8,3,-.5,g);
  const sm=smoke(g,.8,-.5,3.7);return t=>{f.material.emissiveIntensity=.7+.3*Math.sin(t*14);sm(t)}},
 fact(g){B(3.8,2,3,0x94a3b8,0,1,0,g);[-1.2,0,1.2].forEach(x=>{B(1.2,.15,3.2,0x475569,x,2.25,0,g).rotation.z=.45});
  B(.9,1.3,.1,0x1e293b,0,.65,1.52,g);[-1.3,1.3].forEach(x=>glow(B(.55,.45,.1,0xfde68a,x,1.3,1.52,g),0xfacc15));
  Cy(.3,.35,2,0x7f1d1d,-1.4,3,-.9,g);Cy(.3,.35,2,0x7f1d1d,1.4,3,-.9,g);const a=smoke(g,-1.4,-.9,4),b=smoke(g,1.4,-.9,4);return t=>{a(t);b(t+.4)}},
 reac(g){Cy(1.6,1.8,.5,0x334155,0,.25,0,g);const c=glow(Cy(.9,.9,2.4,0x38bdf8,0,1.7,0,g),0x38bdf8);Cy(.6,.9,.4,0x475569,0,3.1,0,g);
  const r1=mesh(new THREE.TorusGeometry(1.25,.12,8,24),0xe2e8f0,0,1.7,0,g),r2=mesh(new THREE.TorusGeometry(1.25,.12,8,24),0xe2e8f0,0,1.7,0,g);
  r1.rotation.x=Math.PI/2;r2.rotation.set(Math.PI/2,.9,0);
  return t=>{c.material.emissiveIntensity=.6+.4*Math.sin(t*4);r1.rotation.z=t*1.5;r2.rotation.z=-t*2}}};

/* juegos */
const DIFF={easy:{t:'Fácil',n:30,cp:6,step:6,w:5,rise:.45,amp:3,mv:0,dis:0,spd:1},
 medium:{t:'Medio',n:40,cp:8,step:6.6,w:3.4,rise:.6,amp:5,mv:4,dis:0,spd:1.3},
 hard:{t:'Difícil',n:50,cp:10,step:7.2,w:2.4,rise:.7,amp:5.5,mv:5,dis:3,spd:1.8}};
let LOB=[];
function lboard(){const c=document.createElement('canvas');c.width=420;c.height=340;const t=new THREE.CanvasTexture(c);
 const s=new THREE.Sprite(new THREE.SpriteMaterial({map:t,depthTest:false}));s.scale.set(8.4,6.8,1);s.renderOrder=5;
 s.set=(rows,title)=>{const g=c.getContext('2d');g.clearRect(0,0,420,340);g.fillStyle='rgba(20,22,40,.85)';g.fillRect(0,0,420,340);
  g.fillStyle='#ffd23f';g.font='900 34px Nunito,sans-serif';g.textAlign='center';g.fillText('🏆 '+title,210,48);g.font='800 28px Nunito,sans-serif';
  if(!rows.length){g.fillStyle='#9aa0c8';g.fillText('Sin récords aún',210,180)}
  rows.forEach((r,i)=>{g.fillStyle='#fff';g.textAlign='left';g.fillText((i+1)+'. '+r[0].slice(0,12),24,100+i*46);g.textAlign='right';g.fillText(r[1].toFixed(1)+' s',396,100+i*46)});t.needsUpdate=true};
 W.add(s);return s}
const GM={
 tycoon:{
  build(){
   plats.push({x0:-65,x1:65,z0:-65,z1:65,top:0},{x0:18,x1:42,z0:-12,z1:12,top:.2});
   mesh(new THREE.BoxGeometry(130,.2,130),0x5fb55a,0,-.1,0,null,false).receiveShadow=true;
   mesh(new THREE.CylinderGeometry(8,8,.2,32),0xb8b3a6,0,.02,0).receiveShadow=true;
   B(11,.1,3,0xcdb98a,13,.03,0).receiveShadow=true;
   mesh(new THREE.CylinderGeometry(12.5,12.5,.1,32),0xecd9a0,0,.02,-32,null,false);
   const lk=mesh(new THREE.CylinderGeometry(10,10,.15,32),0x3b8fd6,0,.06,-32,null,false);lk.material.transparent=true;lk.material.opacity=.9;circ.push({x:0,z:-32,r:10});
   B(24,.2,24,0x8a909c,30,.1,0).receiveShadow=true;
   const wall=(x0,x1,z0,z1)=>{boxes.push([x0,x1,z0,z1]);B(x1-x0,1.4,z1-z0,0x8b5a2b,(x0+x1)/2,.7,(z0+z1)/2)};
   wall(18,42,-12.3,-11.7);wall(18,42,11.7,12.3);wall(41.7,42.3,-12,12);wall(17.7,18.3,-12,-3);wall(17.7,18.3,3,12);
   for(let i=0;i<170;i++){const x=rnd()<.7?-60+rnd()*44:-60+rnd()*120,z=-60+rnd()*120;
    if(Math.hypot(x,z)<11||Math.hypot(x,z+32)<14||(x>8&&x<50&&Math.abs(z)<15))continue;tree(x,z)}
   ITEMS.forEach(i=>{i.pad=B(3,.15,3,0x12b886,i.x,.27,i.z);i.lab=label();i.lab.position.set(i.x,2.8,i.z);
    const mz=i.z+(i.z<0?-3.8:3.8);i.g=new THREE.Group();i.g.position.set(i.x,.2,mz);if(i.z>0)i.g.rotation.y=Math.PI;W.add(i.g);
    i.anim=MODELS[i.id](i.g);i.g.visible=false;i.ml=label();i.ml.position.set(i.x,5.2,mz);i.ml.visible=false;circ.push({x:i.x,z:mz,r:1.9})});
   BANK.pad=B(3,.15,3,0xe0a100,BANK.x,.27,BANK.z);BANK.lab=label();BANK.lab.position.set(BANK.x,2.8,BANK.z);
   for(let i=0;i<18;i++){const c=mesh(new THREE.CylinderGeometry(.5,.5,.12,16).rotateX(Math.PI/2),0xf5b700,0,1,0,null,false);respawn(c);coins.push(c)}},
  upd(dt,t){
   S.bank+=cps()*dt;cd-=dt;let hint='',on=false;
